{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Занятие 5, задача 4. Строка подключения к базе данных.
  // SQLite хранит всю базу в ОДНОМ файле: tasks.db (рядом с проектом).
  "ConnectionStrings": {
    "TaskDb": "Data Source=tasks.db"
  },

  // Ограничение частоты запросов к /api (ДЗ занятия 2).
  // В занятии 2 было 5 запросов за 10 секунд. С занятия 3 сайт многостраничный
  // и делает больше AJAX-запросов (добавление задачи = POST + GET списка),
  // поэтому лимит вынесен сюда и увеличен, чтобы не мешать обычной работе.
  "RateLimiting": {
    "MaxRequests": 30,
    "WindowSeconds": 10
  }
}
