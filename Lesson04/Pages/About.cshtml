@page
@model AboutModel
@* дз зан3: инфа о серваке без единого ajax - всё подставил razor из AboutModel (заполняется в OnGet) *@

<section class="card">
    <h2>О сервере</h2>
    <table class="info-table">
        <tr><td>Имя сервера:</td><td>@Model.ServerName</td></tr>
        <tr><td>Версия:</td><td>@Model.Version</td></tr>
        <tr><td>Запущен:</td><td>@Model.StartedAt.ToString("dd.MM.yyyy HH:mm:ss")</td></tr>
        <tr><td>Время на сервере:</td><td>@Model.CurrentTime.ToString("dd.MM.yyyy HH:mm:ss")</td></tr>
        <tr><td>Работает:</td><td>@Model.Uptime.ToString(@"hh\:mm\:ss")</td></tr>
    </table>
    <p class="muted">Обновите страницу (F5), чтобы увидеть новое время: каждый раз HTML формируется сервером заново.</p>
</section>
