@page
@model TasksModel
@{
    // зан4 зад1: заголовок вкладки, layout выводит его в <title>
    ViewData["Title"] = "Задачи";
}
@* зан3 зад4: отдельная страница /Tasks - тока список задач
   разметку и js перенес с главной (зан1 зад8-10 и дз, зан2 зад4 и 7) *@

@* зан4 зад10: h1 и описание теперь выводит общий _Layout (из ViewData["Title"] и ViewData["Description"]) *@

@* зан4 зад4: сообщение после редиректа
   чтение TempData["Message"] помечает его прочитанным - после запроса удалится, и на F5 его уже не будет (один раз) *@
@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
@* зан4 зад9: ошибка отдельным красным блоком (alert-error) *@
@if (TempData["Error"] != null)
{
    <div class="alert alert-error">@TempData["Error"]</div>
}
@* зан4 зад8: эксперимент с TempData.Peek() - читает БЕЗ удаления:

       var msg = TempData.Peek("Message");  ...  if (msg != null) { показать msg }

   Peek НЕ помечает на удаление, поэтому сообщение остается и после F5.
   проверил: оно вообще не пропадает (даже если уйти на /Stats и вернуться), пока кто-то не прочитает обычным TempData["Message"]
   когда норм: надо "глянуть" значение не тратя его (проверить есть ли сообщение, а вывести в другом месте),
   или пережить одно лишнее обновление - тогда вместе с TempData.Keep("Message")
   когда плохо: для сообщений типа "задача добавлена" - юзер видит его на каждом F5 и думает что добавилась еще раз
   поэтому в коде оставил обычное чтение TempData["Message"] (ровно один раз) *@
@* зан4 зад2 (было): тут выводил ViewBag.PageDescription - читал через ViewBag то что записал через ViewData в OnGet()
   сработало потому что ViewBag и ViewData это один и тот же словарь. с зад10 описание выводит _Layout *@

    <!-- зад8-10 + дз: список задач -->
    <section class="card">
        <h2>Список</h2>
        @* дз зан5 -> зан8 зад7: фильтр по категории
           method="get" - выбор попадает в адрес /Tasks?categoryId=2 и прилетает в OnGetAsync(int? categoryId) *@
        <form method="get" class="filter-form">
            <label for="categoryFilter">Категория:</label>
            <select id="categoryFilter" name="categoryId">
                <option value="">Все задачи</option>
                @foreach (var c in Model.AllCategories)
                {
                    <option value="@c.Id" selected="@(c.Id == Model.SelectedCategoryId)">@c.Name</option>
                }
            </select>
            @* дз: поиск по названию в той же форме что фильтр *@
            <label for="searchBox">Поиск:</label>
            <input id="searchBox" type="text" name="search" value="@Model.Search" placeholder="часть названия" />
            @* зад10: сортировка не слетает когда меняешь фильтр или поиск *@
            <input type="hidden" name="sortBy" value="@Model.SortBy" />
            <button type="submit">Применить</button>
        </form>

        @* === зан8 зад10: переключалка сортировки ===
           ссылки не теряют категорию и номер страницы: /Tasks?categoryId=2&sortBy=title&pageNumber=2 *@
        <div class="sort-links">
            Сортировка:
            <a asp-page="/Tasks" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-search="@Model.Search" asp-route-sortBy="date"
               asp-route-pageNumber="@Model.CurrentPage" class="@(Model.SortBy == "date" ? "active" : "")">По дате</a>
            <a asp-page="/Tasks" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-search="@Model.Search" asp-route-sortBy="title"
               asp-route-pageNumber="@Model.CurrentPage" class="@(Model.SortBy == "title" ? "active" : "")">По названию</a>
        </div>

        <button id="loadTasksBtn">Обновить список</button>

        @* зад5: список рисует СЕРВАК при загрузке (ни одного ajax)
           Model.InitialTasks заполняется в TasksModel.OnGet() (Tasks.cshtml.cs)
           razor сам экранирует task.Title, так что html в названии не сработает *@
        @* зан8 зад9: список и кнопки страниц в #taskListBlock - после ajax js меняет ЭТОТ блок на свежий html с сервака *@
        <div id="taskListBlock">
            @if (Model.InitialTasks.Count == 0)
            {
                @* зан3 зад10: сообщение вместо пустого списка *@
                <p class="empty-message">
                    @if (Model.TotalCount > 0)
                    {
                        @($"На странице {Model.CurrentPage} задач нет.")
                    }
                    else if (Model.Search != null || Model.SelectedCategoryId != null)
                    {
                        @("По заданным условиям (поиск / категория) задач не найдено.")
                    }
                    else
                    {
                        @("Задач пока нет, добавьте первую!")
                    }
                </p>
            }
            else
            {
                <ul id="taskList" class="task-list">
                    @foreach (var task in Model.InitialTasks)
                    {
                        @* зан3 зад6: разметка одной строки в partial Pages/Shared/_TaskItem.cshtml *@
                        <partial name="_TaskItem" model="task" />
                    }
                </ul>
            }

            @* === зан8 зад9: кнопки назад/далее ===
               asp-route-pageNumber и asp-route-categoryId дописывают параметры в ссылку: /Tasks?pageNumber=2&categoryId=3
               (не asp-route-page - "page" в razor pages занят, см Tasks.cshtml.cs)
               на первой странице Назад неактивна, на последней Далее *@
            @if (Model.TotalPages > 1 || Model.CurrentPage > 1)
            {
                <nav class="pager">
                    @if (Model.CurrentPage > 1)
                    {
                        <a asp-page="/Tasks" asp-route-pageNumber="@Math.Min(Model.CurrentPage - 1, Model.TotalPages)" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-search="@Model.Search" asp-route-sortBy="@Model.SortBy">&larr; Назад</a>
                    }
                    else
                    {
                        <span class="disabled">&larr; Назад</span>
                    }

                    <span>Страница @Model.CurrentPage из @Math.Max(Model.TotalPages, 1) (задач: @Model.TotalCount)</span>

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a asp-page="/Tasks" asp-route-pageNumber="@(Model.CurrentPage + 1)" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-search="@Model.Search" asp-route-sortBy="@Model.SortBy">Далее &rarr;</a>
                    }
                    else
                    {
                        <span class="disabled">Далее &rarr;</span>
                    }
                </nav>
            }
        </div>

        <!-- зад9: добавить через ajax (без перезагрузки) -->
        <h3>Добавить задачу (AJAX)</h3>
        <input id="newTaskTitle" type="text" placeholder="Новая задача" data-api-field="title">
        @* зан8: категории из таблицы Categories (value = Id) *@
        <select id="newTaskCategory" asp-items="Model.CategoryOptions" data-api-field="categoryId">
            <option value="">Без категории</option>
        </select>
        <input id="newTaskDueDate" type="date" title="Срок (необязательно)" data-api-field="dueDate">
        <button id="addTaskBtn">Добавить задачу</button>
        <div id="taskMessage"></div>

        @* зан4 зад3: обычная html форма, работает даже без js
           method="post" -> браузер шлет POST на этот же адрес (/Tasks) -> срабатывает OnPost
           страница ПОЛНОСТЬЮ перезагружается (редирект), в отличие от ajax формы выше
           тег-хелпер form сам добавляет скрытый __RequestVerificationToken (защита от CSRF) *@
        <h3>Добавить задачу (обычная форма)</h3>
        @* зан6 зад8: поля на тег-хелперах asp-for="NewTask.*" вместо name="title"
           ошибка (asp-validation-for) показывается так же как на странице редактирования *@
        <form method="post">
            <input asp-for="NewTask.Title" placeholder="Новая задача" />
            @* зан8 зад5: выбор категории из таблицы Categories:
               asp-for="NewTask.CategoryId" - выбранный Id попадет в NewTask.CategoryId
               asp-items - варианты из TasksModel.CategoryOptions (SelectList из базы) *@
            <select asp-for="NewTask.CategoryId" asp-items="Model.CategoryOptions">
                <option value="">Без категории</option>
            </select>
            @* дз зан7: срок (type="date" из-за [DataType(DataType.Date)]) *@
            <input asp-for="NewTask.DueDate" title="Срок (необязательно)" />
            <button type="submit">Добавить (с перезагрузкой)</button>
            <div><span asp-validation-for="NewTask.Title" class="field-error"></span></div>
            <div><span asp-validation-for="NewTask.DueDate" class="field-error"></span></div>
        </form>

        <!-- зан2 зад4: найти задачу по id -->
        <h3>Найти задачу по номеру</h3>
        <input id="findTaskId" type="number" min="1" placeholder="id">
        <button id="findTaskBtn">Найти задачу</button>
        <div id="findTaskResult" class="result"></div>

        <!-- зан9 зад10: живой поиск, запрос на каждую букву -->
        <h3>Живой поиск</h3>
        <input id="liveSearch" type="text" placeholder="Начните вводить название...">
        <ul id="liveSearchResults" class="live-results"></ul>
    </section>

@* зад7: скрипт для списка задач - в section Scripts
   layout выводит её в RenderSection("Scripts"), поэтому этот js попадает ТОКА на эту страницу *@
@section Scripts {
    @* зан7 зад2: валидация в браузере (unobtrusive) для обычной формы добавления *@
    <partial name="_ValidationScriptsPartial" />
    @* зан7 зад6: проверки руками, которых нет в unobtrusive *@
    <script src="~/js/title-checks.js"></script>

    <script>
        // зан9 зад11: все запросы к api через apiRequest() (wwwroot/js/api.js):
        // она ставит X-Api-Key и Content-Type, проверяет код, разбирает ошибки и показывает всплывашку
        // тут остается тока "что делать с результатом"

        // защита от html-инъекций: если назвать задачу "<b>жирно</b>", покажется текстом, а не разметкой
        function escapeHtml(text) {
            const div = document.createElement("div");
            div.textContent = text;
            return div.innerHTML;
        }

        // сообщение под формой добавления (ошибка красным)
        function showTaskMessage(text, isError) {
            document.getElementById("taskMessage").innerHTML =
                text ? `<span class="${isError ? "error" : "ok"}">${escapeHtml(text)}</span>` : "";
        }

        // === зан8 зад9: обновление списка после ajax ===
        // список с пагинацией, сортировкой и фильтром собирает СЕРВЕР. поэтому прошу ЭТУ ЖЕ страницу
        // (тот же адрес с ?pageNumber=..&categoryId=..), беру из ответа готовый #taskListBlock
        // (строки рисует partial _TaskItem) и подменяю. это html, а не api, поэтому обычный fetch
        async function loadTasks() {
            const response = await fetch(location.href);
            if (!response.ok) {
                showTaskMessage(`Ошибка ${response.status}`, true);
                return;
            }
            const html = await response.text();                                // ответ - текст html
            const doc = new DOMParser().parseFromString(html, "text/html");     // текст -> документ
            document.getElementById("taskListBlock").innerHTML =
                doc.getElementById("taskListBlock").innerHTML;                  // подменяю тока список
        }

        document.getElementById("loadTasksBtn").addEventListener("click", loadTasks);

        // === зан1 зад9: добавить задачу (ajax) ===
        // после POST обновляю список с сервака, правда тока там
        document.getElementById("addTaskBtn").addEventListener("click", async () => {
            const input = document.getElementById("newTaskTitle");

            // зан7 зад8: ПЕРВЫЙ рубеж - проверка в браузере ДО отправки (сразу, без запроса)
            // ВТОРОЙ рубеж - сервак (400), его ошибки покажет apiRequest
            const problem = findTitleProblem(input.value);   // функция в wwwroot/js/title-checks.js
            if (problem) {
                showTaskMessage(problem, true);
                return;
            }

            // зан9 зад9: индикатор загрузки - кнопка заблочена пока идет запрос,
            // чтоб на медленном инете не нажать второй раз и не сделать дубль
            const button = document.getElementById("addTaskBtn");
            button.disabled = true;
            button.textContent = "Сохранение...";

            try {
                const category = document.getElementById("newTaskCategory").value;
                const task = await apiRequest("/api/tasks", {
                    method: "POST",
                    body: {
                        title: input.value,
                        categoryId: category ? Number(category) : null,                    // зан8
                        dueDate: document.getElementById("newTaskDueDate").value || null   // дз зан7
                    }
                });

                input.value = "";
                showTaskMessage(`Задача №${task.id} добавлена`, false);
                await loadTasks();
            } catch (err) {
                showTaskMessage(err.message, true);  // ошибку уже показала всплывашка
            } finally {
                // finally выполняется ВСЕГДА, и после успеха и после ошибки - кнопка точно разблочится
                button.disabled = false;
                button.textContent = "Добавить задачу";
            }
        });

        // === зан1 зад10: удаление (ajax) ===
        // button - кнопка которую нажали (this), блочу её пока идет запрос (зан9 зад9)
        // если ок - сервак отдает 204 без тела (зан9 зад7), apiRequest вернет null
        async function deleteTask(id, button) {
            button.disabled = true;
            button.textContent = "Удаление...";
            try {
                await apiRequest(`/api/tasks/${id}`, { method: "DELETE" });
                showTaskMessage(`Задача №${id} удалена`, false);
                await loadTasks();                    // строка пропадет вместе с кнопкой
            } catch (err) {
                showTaskMessage(err.message, true);
                button.disabled = false;              // строка осталась - разблочиваю кнопку
                button.textContent = "Удалить";
            }
        }

        // === зан6 зад9: чекбокс выполнено (ajax PUT) ===
        // checkbox - сама галка (this в разметке)
        // зан9 зад4: PUT хочет UpdateTaskDto со всеми полями, название и категорию беру из data-атрибутов строки
        async function toggleTask(id, checkbox) {
            const isDone = checkbox.checked;
            const li = checkbox.closest("li");

            checkbox.disabled = true;                 // зан9 зад9: пока идет запрос
            try {
                const task = await apiRequest(`/api/tasks/${id}`, {
                    method: "PUT",
                    body: {
                        title: li.dataset.title,
                        isDone: isDone,
                        categoryId: li.dataset.categoryId ? Number(li.dataset.categoryId) : null
                    }
                });
                // класс "done" зачеркивает текст, toggle(имя, условие) добавляет или убирает класс
                li.classList.toggle("done", task.isDone);
            } catch (err) {
                checkbox.checked = !isDone;           // ошибка (типа 404) - возвращаю галку
                showTaskMessage(err.message, true);
            } finally {
                checkbox.disabled = false;
            }
        }

        // === зан9 зад10: живой поиск + отмена старых запросов ===
        // race condition: быстро печатаешь "з", "за", "зад", а ответ на "з" приходит ПОСЛЕДНИМ и затирает норм результат
        // AbortController отменяет предыдущий запрос. отмененный apiRequest вернет null - его пропускаю
        let currentController = null;      // "пульт отмены" текущего запроса

        async function liveSearch(query) {
            const results = document.getElementById("liveSearchResults");

            if (currentController) {
                currentController.abort();  // отменяю прошлый запрос (если еще идет)
            }
            if (query.trim() === "") {
                results.innerHTML = "";
                currentController = null;
                return;
            }

            currentController = new AbortController();
            try {
                const data = await apiRequest(`/api/tasks?search=${encodeURIComponent(query)}&pageSize=10`, {
                    signal: currentController.signal
                });
                if (data === null) {
                    return;                 // запрос отменен - на экране будет результат нового
                }
                results.innerHTML = data.items.length === 0
                    ? "<li>Ничего не найдено</li>"
                    : data.items.map(t => `<li>#${t.id} ${escapeHtml(t.title)}</li>`).join("");
                results.dataset.query = query;
            } catch (err) {
                results.innerHTML = `<li class="error">${escapeHtml(err.message)}</li>`;
            }
        }

        // input срабатывает на КАЖДОЕ изменение текста
        document.getElementById("liveSearch").addEventListener("input", (event) => {
            liveSearch(event.target.value);
        });

        // === зан2 зад4: найти задачу по id ===
        document.getElementById("findTaskBtn").addEventListener("click", async () => {
            const id = document.getElementById("findTaskId").value;
            const resultBlock = document.getElementById("findTaskResult");
            try {
                const task = await apiRequest(`/api/tasks/${encodeURIComponent(id)}`);
                resultBlock.innerHTML =
                    `<span class="ok">Задача №${task.id}: <b>${escapeHtml(task.title)}</b> — ` +
                    `${task.isDone ? "выполнена" : "не выполнена"}</span>`;
            } catch (err) {
                resultBlock.innerHTML = `<span class="error">Ошибка ${err.status ?? ""}: ${escapeHtml(err.message)}</span>`;
            }
        });

        // зан7 зад6: проверка слова "тест" в обычной форме добавления
        attachForbiddenWordsCheck(
            document.getElementById("NewTask_Title").form,
            document.getElementById("NewTask_Title"));

        // зан3 зад5: при открытии список НЕ грузится через ajax - его уже нарисовал сервак
        // ajax тока после добавления/удаления/галочки
    </script>
}
