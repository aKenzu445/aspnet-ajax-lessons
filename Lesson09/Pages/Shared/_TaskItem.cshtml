@model TaskItem
@* зан3 зад6: partial view - кусок разметки который юзаю много раз:
   ОДНА строка списка (чекбокс + текст + кнопки). принимает один TaskItem (model выше)
   в Tasks.cshtml: <partial name="_TaskItem" model="task" />

   ОГРАНИЧЕНИЕ: этот файл работает тока на СЕРВАКЕ когда собирается страница.
   js в браузере не может его вызвать когда задача добавляется через ajax,
   поэтому в js (taskToHtml в Tasks.cshtml) та же разметка продублирована строкой.
   это граница между серверным (razor) и клиентским (js) рендерингом - менять надо в ОБОИХ местах *@
@* зан9 зад4: в data-* атрибутах название и категория задачи прям в разметке
   PUT теперь хочет ВСЕ поля (UpdateTaskDto), чекбокс берет их отсюда
   если CategoryId == null, data-category-id будет пустой *@
<li class="@(Model.IsDone ? "done" : "")" data-title="@Model.Title" data-category-id="@Model.CategoryId">
    <input type="checkbox" checked="@Model.IsDone"
           onchange="toggleTask(@Model.Id, this)">
    <span class="task-title">#@Model.Id @Model.Title</span>
    @* дз зан5 -> зан8 зад6: название категории через навигационное свойство
       оно есть потому что в TasksModel задачи грузятся с .Include(t => t.Category)
       ?. - на всякий случай, если Category всё-таки null, не падаю *@
    @if (Model.CategoryId != null)
    {
        <span class="task-category">@Model.Category?.Name</span>
    }
    @* зан5 зад11: дата создания. у задач созданных ДО миграции AddCreatedAt в базе 0001-01-01 (default) - пишу "дата неизвестна" *@
    <span class="task-date">@(Model.CreatedAt == default ? "дата неизвестна" : Model.CreatedAt.ToString("dd.MM.yyyy HH:mm"))</span>
    @* дз зан7: срок, если есть *@
    @if (Model.DueDate != null)
    {
        <span class="task-due">срок: @Model.DueDate.Value.ToString("dd.MM.yyyy")</span>
    }
    @* зан6 зад6: ссылка на редактирование. asp-page + asp-route-id сами делают href="/Tasks/Edit/3" *@
    <a asp-page="/Tasks/Edit" asp-route-id="@Model.Id" class="button-link">Редактировать</a>
    @* this - сама кнопка, зан9 зад9 блочит её пока идет запрос *@
    <button onclick="deleteTask(@Model.Id, this)">Удалить</button>
    @* зан4 зад5: обычная кнопка удаления (работает без js)
       asp-page-handler="Delete" -> вызовется OnPostDelete, asp-route-id -> параметр id
       тег-хелпер сделает action="/Tasks?id=3&handler=Delete" и добавит токен *@
    <form method="post" asp-page="/Tasks" asp-page-handler="Delete" asp-route-id="@Model.Id" class="inline-form">
        <button type="submit" title="Удалить через обычную форму (с перезагрузкой)">Удалить (форма)</button>
    </form>
</li>
