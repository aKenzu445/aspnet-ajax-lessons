@page
@model ErrorModel
@* зан3 зад9: нормальная страница ошибки для ОБЫЧНЫХ страниц сайта
   сюда кидает app.UseExceptionHandler("/Error") если страница (не /api/...) упала
   юзает общий _Layout, так что шапка и меню на месте *@
@{
    ViewData["Title"] = "Ошибка";
}

<section class="card error-page">
    <h2>Что-то пошло не так 😕</h2>
    <p>При обработке запроса произошла ошибка. Мы уже знаем о ней (подробности записаны в лог сервера).</p>
    <p class="muted">Код запроса для поддержки: <code>@Model.RequestId</code></p>
    <a class="button" href="/">На главную</a>
</section>
